# ==============================================================================
# HeroCMS Stack Environment Variables (.env.example)
# Salin file ini menjadi .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Port Mapping Host & Services
# ------------------------------------------------------------------------------
DASHBOARD_PORT=8085
MARKETING_PORT=8084
DOCS_PORT=8087
KAFKA_EXTERNAL_PORT=19092

# ------------------------------------------------------------------------------
# 2. Database PostgreSQL 16
# ------------------------------------------------------------------------------
DB_DATABASE=cloudcms_db
DB_USERNAME=cloudcms_user
DB_PASSWORD=secret_postgres_password
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis 7 Cache, Session Store & Mutex
# ------------------------------------------------------------------------------
REDIS_PASSWORD=secret_redis_password
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Keamanan & Internal Secret Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_herocms_enterprise_production_2026
INTERNAL_SECRET_TOKEN=herocms_internal_secret_key_v1

# ------------------------------------------------------------------------------
# 5. Ingress, SSL/TLS Let's Encrypt & Cloudflare Tunnel
# ------------------------------------------------------------------------------
ACME_EMAIL=admin@herocms.stackbyte.id
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZS10b2tlbi1mb3ItY2xvdWRmbGFyZS10dW5uZWwifQ==
CORS_ALLOWED_ORIGINS=https://herocms.stackbyte.id,https://studio.herocms.stackbyte.id,https://studio-herocms.stackbyte.id,http://localhost:8085,http://localhost:8084,http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Service 03 Provision Orchestrator Settings
# ------------------------------------------------------------------------------
TENANT_RUNTIME_IMAGE=cloudcms-tenant-runtime:alpine-v1
TENANT_STORAGE_BASE=/var/lib/herocms/tenants

# ------------------------------------------------------------------------------
# 7. MinIO S3 Object Storage (Asset Segregation & Media Quota)
# ------------------------------------------------------------------------------
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=secret_minio_password
S3_BUCKET=herocms-media
S3_USE_SSL=false
S3_PUBLIC_URL=http://minio.stackbyte.id
