# ==============================================================================
# HeroCMS Platform Environment Configuration
# Salin file ini menjadi .env: cp .env.example .env
# ==============================================================================

# Port Server Backend & Static Host (Golang)
PORT=8085

# Kunci Rahasia JWT (Minimal 32 karakter acak untuk enkripsi HS256)
JWT_SECRET=super_secret_jwt_key_herocms_enterprise_production_2026

# Konfigurasi Database PostgreSQL 16 (Multi-Tenant dengan Row-Level Security)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=cloudcms_user
DB_PASSWORD=secret_postgres_password
DB_DATABASE=cloudcms_db

# Konfigurasi Redis 7 (Cache, Sliding-Window Rate Limiting, Top-Views ZSET)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=secret_redis_password

# Integrasi Orkestrator Kontainer Go (Program 3)
ORCHESTRATOR_URL=http://127.0.0.1:8080

# Direktori Build Frontend Vue 3
DIST_DIR=./dist

# ==============================================================================
# Security, CORS & CSRF Configuration
# ==============================================================================
# Domain asal yang diizinkan mengakses API (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:8081,http://localhost:8085,http://127.0.0.1:8085,https://cloudcms.app,https://*.cloudcms.app
CORS_ALLOW_CREDENTIALS=true

# Proteksi CSRF (Double Submit Cookie Pattern)
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_COOKIE_DOMAIN=
CSRF_COOKIE_SECURE=false

