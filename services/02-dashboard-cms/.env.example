# ==============================================================================
# HeroCMS Studio (Dashboard CMS) Environment
# ==============================================================================

PORT=8085
JWT_SECRET=super_secret_jwt_key_herocms_enterprise_production_2026

# PostgreSQL 16
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=cloudcms_user
DB_PASSWORD=secret_postgres_password
DB_DATABASE=cloudcms_db

# Redis 7
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=secret_redis_password

# Container Orchestrator
ORCHESTRATOR_URL=http://127.0.0.1:8080
DIST_DIR=./dist

# MinIO S3 Object Storage
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=secret_minio_password
S3_BUCKET=herocms-media
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000/herocms-media

# ==============================================================================
# Security, CORS & CSRF Configuration
# ==============================================================================
# Domain asal yang diizinkan mengakses API (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:8081,http://localhost:8085,http://127.0.0.1:8085,https://cloudcms.app,https://*.cloudcms.app
CORS_ALLOW_CREDENTIALS=true

# Proteksi CSRF (Double Submit Cookie Pattern)
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_COOKIE_DOMAIN=
CSRF_COOKIE_SECURE=false

