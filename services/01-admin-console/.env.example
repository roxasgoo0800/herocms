APP_NAME=CloudCMS_Admin
APP_ENV=local
APP_KEY=base64:randomkeyhere
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8001

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
